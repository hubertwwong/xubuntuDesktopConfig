#!/usr/bin/env python3
"""town - Portable task and multi-agent plan tracker across workspaces."""

import argparse
import os
import re
import sys
from datetime import datetime
from pathlib import Path


def find_project_root() -> Path:
    """Find the project root by walking upwards looking for ai/plan.md, ai/plans, ai/ledger.md, or .git."""
    curr = Path.cwd().resolve()
    for parent in [curr] + list(curr.parents):
        if (parent / "ai" / "plan.md").is_file():
            return parent
        if (parent / "ai" / "plans").is_dir() or (parent / "ai" / "ledger.md").is_file():
            return parent
        if (parent / ".git").is_dir() and (parent / "ai").is_dir():
            return parent

    return curr


def parse_plan(plan_file: Path) -> dict:
    """Extract metadata and criteria from a markdown plan file."""
    content = plan_file.read_text(encoding="utf-8")
    meta = {
        "id": plan_file.stem.split("_")[0],
        "title": plan_file.stem,
        "status": "UNKNOWN",
        "stage": "UNKNOWN",
        "flow": "Standard",
        "file": plan_file,
        "total_criteria": 0,
        "checked_criteria": 0,
        "created_at": "",
        "updated_at": "",
    }

    # Parse YAML frontmatter if present
    frontmatter_match = re.match(r"^---\s*\n(.*?)\n---\s*\n", content, re.DOTALL)
    if frontmatter_match:
        for line in frontmatter_match.group(1).splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                k = k.strip().lower()
                v = v.strip().strip('"').strip("'")
                meta[k] = v

    # Count acceptance criteria checkboxes
    all_checkboxes = re.findall(r"-\s*\[([ xX])\]", content)
    meta["total_criteria"] = len(all_checkboxes)
    meta["checked_criteria"] = sum(1 for c in all_checkboxes if c.lower() == "x")

    # Fallback title from first H1
    if meta["title"] == plan_file.stem or meta["title"] == "plan":
        h1_match = re.search(r"^#\s+(?:PLAN-\d+:\s*)?(.+)$", content, re.MULTILINE)
        if h1_match:
            meta["title"] = h1_match.group(1).strip()

    return meta


def get_all_plans(root: Path) -> list[dict]:
    """Return all sub-plans in ai/plans/ sorted by ID."""
    plans = []
    plans_dir = root / "ai" / "plans"
    if plans_dir.is_dir():
        for f in plans_dir.glob("*.md"):
            if f.name in ["index.md", "README.md", "active.md"]:
                continue
            try:
                plans.append(parse_plan(f))
            except Exception:
                continue

    plans.sort(key=lambda p: p["id"])
    return plans


def get_active_plan(root: Path) -> dict | None:
    """Return the active uncompleted plan in ai/plans/."""
    for p in get_all_plans(root):
        if p["status"].upper() not in ["COMPLETED", "DONE", "ARCHIVED", "IDLE"]:
            return p
    return None


def cmd_sync_main_plan(root: Path, silent: bool = False):
    """Regenerate ai/plan.md (Main Plan) and ai/ledger.md referencing all sub-plans."""
    ai_dir = root / "ai"
    ai_dir.mkdir(parents=True, exist_ok=True)
    main_plan_file = ai_dir / "plan.md"
    ledger_file = ai_dir / "ledger.md"

    plans = get_all_plans(root)
    active = get_active_plan(root)
    completed = [p for p in plans if p["status"].upper() in ["COMPLETED", "DONE", "ARCHIVED"]]

    now = datetime.now().strftime("%Y-%m-%d %H:%M")

    # Build Main Plan (ai/plan.md)
    lines = [
        f"# 🏛️ Main Project Plan: {root.name.replace('-', ' ').title()}\n",
        f"> *Last updated: {now}*\n",
        "> **Architecture:** Sub-plans are tracked in [`ai/plans/`](./plans/). This Main Plan references active and completed milestones.\n",
        "---\n",
        "## 🟡 Active Task\n",
    ]

    if active:
        crit = f" ({active['checked_criteria']}/{active['total_criteria']} criteria met)" if active['total_criteria'] else ""
        rel_path = active['file'].relative_to(ai_dir)
        lines.append(f"* **Active Plan:** [`{active['id']}: {active['title']}`](./{rel_path})")
        lines.append(f"* **Stage / Role:** 👤 {active['stage'].capitalize()}")
        lines.append(f"* **Status:** 🟡 `{active['status'].upper()}`{crit}\n")
    else:
        lines.append("🟢 **Status:** Idle (No active tasks)\n")

    lines.append("---\n\n## 🗺️ Sub-Plans & Roadmap\n")

    if completed:
        lines.append("### ✅ Completed Plans\n")
        for p in completed:
            crit = f" ({p['checked_criteria']}/{p['total_criteria']} criteria)" if p['total_criteria'] else ""
            rel_path = p['file'].relative_to(ai_dir)
            lines.append(f"- [x] **[`{p['id']}: {p['title']}`](./{rel_path})**{crit}")
        lines.append("")

    # Check for backlog items in todo.md if present
    todo_file = ai_dir / "todo.md"
    backlog_items = []
    if todo_file.is_file():
        todo_content = todo_file.read_text(encoding="utf-8")
        in_backlog = False
        for line in todo_content.splitlines():
            if "## ⏳ Backlog" in line or "## Backlog" in line:
                in_backlog = True
                continue
            elif line.startswith("## "):
                in_backlog = False
            if in_backlog and line.strip().startswith("- [ ]"):
                backlog_items.append(line.strip())

    if backlog_items:
        lines.append("### ⏳ Backlog (Next Up)\n")
        for item in backlog_items:
            lines.append(item)
        lines.append("")

    lines.append("---\n\n## 📚 Knowledge & Documentation\n")
    lines.append("- **Knowledge Catalog:** [`ai/knowledge/index.md`](./knowledge/index.md)")
    lines.append("- **Human Documentation:** [`docs/`](../docs/)\n")

    main_plan_file.write_text("\n".join(lines) + "\n", encoding="utf-8")

    # Also sync ai/ledger.md
    ledger_lines = [
        f"# 🏛️ Town Work Ledger | {root.name}\n",
        f"*Last updated: {now}*\n",
        f"*Main Plan Reference:* [`ai/plan.md`](file://{main_plan_file.resolve()})\n\n",
        "## Active Task\n",
    ]
    if active:
        crit = f" ({active['checked_criteria']}/{active['total_criteria']} criteria met)" if active['total_criteria'] else ""
        rel_path = active['file'].relative_to(root)
        ledger_lines.append(f"* **Plan ID:** `{active['id']}`")
        ledger_lines.append(f"* **Title:** {active['title']}")
        ledger_lines.append(f"* **Stage / Role:** 👤 {active['stage'].capitalize()}")
        ledger_lines.append(f"* **Status:** 🟡 `{active['status'].upper()}`{crit}")
        ledger_lines.append(f"* **File:** [`{rel_path}`](file://{active['file'].resolve()})")
    else:
        ledger_lines.append("🟢 **Status:** Idle (No active tasks)\n")

    ledger_lines.append("\n---\n\n## All Tracked Plans\n")
    ledger_lines.append("| Plan ID | Title | Stage | Status | Criteria | Sub-Plan File |")
    ledger_lines.append("| :--- | :--- | :--- | :--- | :---: | :--- |")
    for p in plans:
        badge = "✅" if p["status"].upper() in ["COMPLETED", "DONE", "ARCHIVED"] else "🟡"
        crit = f"{p['checked_criteria']}/{p['total_criteria']}"
        rel_path = p['file'].relative_to(root)
        ledger_lines.append(
            f"| **{p['id']}** | {p['title']} | {p['stage'].capitalize()} | {badge} `{p['status'].upper()}` | {crit} | [{rel_path}](file://{p['file'].resolve()}) |"
        )

    ledger_file.write_text("\n".join(ledger_lines) + "\n", encoding="utf-8")

    if not silent:
        print(f"✅ Synchronized Main Plan: {main_plan_file}")
        print(f"✅ Synchronized Ledger:    {ledger_file}")


def cmd_status(root: Path):
    """Print current project status and active task."""
    cmd_sync_main_plan(root, silent=True)
    plans = get_all_plans(root)
    print("=" * 60)
    print(f"🏛️  TOWN WORK LEDGER | Project: {root.name}")
    print(f"📁 Root: {root}")
    print(f"📄 Main Plan: ai/plan.md")
    print("=" * 60)

    active = get_active_plan(root)
    completed = [p for p in plans if p["status"].upper() in ["COMPLETED", "DONE", "ARCHIVED"]]

    if active:
        progress_bar = ""
        if active["total_criteria"] > 0:
            done = active["checked_criteria"]
            total = active["total_criteria"]
            pct = int((done / total) * 100)
            progress_bar = f" ({done}/{total} criteria - {pct}%)"

        print("\n🟡 ACTIVE TASK:")
        print(f"  Plan ID:    {active['id']}")
        print(f"  Title:      {active['title']}")
        print(f"  Status:     \033[1;33m{active['status'].upper()}\033[0m")
        print(f"  Stage/Role: 👤 {active['stage'].capitalize()}")
        print(f"  Progress:  {progress_bar}")
        print(f"  Sub-Plan:   {active['file'].relative_to(root)}")
    else:
        print("\n🟢 ACTIVE TASK: None (All plans completed or no active plan)")

    if completed:
        print("\n✅ RECENTLY COMPLETED:")
        for p in completed[-5:]:
            crit = f" ({p['checked_criteria']}/{p['total_criteria']} criteria)" if p['total_criteria'] else ""
            print(f"  • [{p['id']}] {p['title']}{crit}")

    print("\n" + "-" * 60)


def cmd_list(root: Path):
    """List all tracked sub-plans."""
    cmd_sync_main_plan(root, silent=True)
    plans = get_all_plans(root)
    if not plans:
        print(f"No sub-plans found in {root / 'ai' / 'plans'}")
        return

    print(f"{'PLAN ID':<10} {'STATUS':<14} {'STAGE':<12} {'CRITERIA':<10} {'TITLE'}")
    print("-" * 75)
    for p in plans:
        crit = f"{p['checked_criteria']}/{p['total_criteria']}"
        status_color = "\033[1;32m" if p["status"].upper() in ["COMPLETED", "DONE", "ARCHIVED"] else "\033[1;33m"
        reset = "\033[0m"
        status_str = f"{status_color}{p['status'].upper()}{reset}"
        print(f"{p['id']:<10} {status_str:<23} {p['stage'].capitalize():<12} {crit:<10} {p['title']}")


def cmd_show(root: Path, plan_id: str = None):
    """Display the full content of a sub-plan or the Main Plan."""
    cmd_sync_main_plan(root, silent=True)
    plans = get_all_plans(root)

    if not plan_id or plan_id.lower() in ["main", "main-plan", "plan"]:
        main_plan = root / "ai" / "plan.md"
        if main_plan.is_file():
            print(f"\n--- ai/plan.md (Main Plan) ---")
            print(main_plan.read_text(encoding="utf-8"))
            return

    target = None
    if plan_id:
        for p in plans:
            if p["id"].lower() == plan_id.lower() or plan_id.lower() in p["title"].lower():
                target = p
                break
    else:
        target = get_active_plan(root)
        if not target and plans:
            target = plans[-1]

    if not target:
        print(f"Plan '{plan_id}' not found.")
        return

    print(f"\n--- {target['file'].relative_to(root)} ---")
    print(target["file"].read_text(encoding="utf-8"))


def cmd_new(root: Path, title: str, flow: str = "Flow 1 (Full Council)"):
    """Create a new sub-plan in ai/plans/ and reference it in the Main Plan (ai/plan.md)."""
    ai_dir = root / "ai"
    plans_dir = ai_dir / "plans"
    plans_dir.mkdir(parents=True, exist_ok=True)

    # Determine next plan ID number
    highest_num = 0
    for p in get_all_plans(root):
        m = re.match(r"^PLAN-(\d+)", p["id"])
        if m:
            highest_num = max(highest_num, int(m.group(1)))

    next_id = f"PLAN-{highest_num + 1:03d}"
    slug = re.sub(r"[^a-zA-Z0-9]+", "_", title.strip().lower()).strip("_")
    sub_plan_path = plans_dir / f"{next_id}_{slug}.md"

    now = datetime.now().isoformat()
    template = f"""---
id: {next_id}
title: {title}
status: IN_PROGRESS
stage: planner
created_at: {now}
updated_at: {now}
assigned_flow: {flow}
---

# {next_id}: {title}

## 1. Blueprint by Planner
- **Objective:** {title}
- **Target Files:**
  - `src/...`
  - `tests/...`

### Acceptance Criteria
- [ ] Implement core functionality
- [ ] Comprehensive unit test coverage
- [ ] Zero regressions and clean test execution

## 2. Forged by Coder
*(Pending execution by Coder)*

## 3. Inspection Report by Auditor
*(Pending inspection by Auditor)*

## 4. Documentation & Archive by Clerk
*(Pending closure by Clerk)*
"""
    sub_plan_path.write_text(template, encoding="utf-8")

    # Purge old bulletin.md if present
    bulletin = ai_dir / "bulletin.md"
    if bulletin.is_file():
        bulletin.unlink()

    # Sync Main Plan
    cmd_sync_main_plan(root, silent=True)

    print(f"✅ Created sub-plan: {next_id} ({title})")
    print(f"   Sub-Plan File: {sub_plan_path.relative_to(root)}")
    print(f"   Main Plan:     ai/plan.md (referenced as Active Task)")
    print(f"   Stage: 👤 Planner | Status: 🟡 IN_PROGRESS")


def cmd_init(root: Path):
    """Initialize the town multi-agent tracking structure in any directory."""
    ai_dir = root / "ai"
    plans_dir = ai_dir / "plans"
    todo = ai_dir / "todo.md"

    plans_dir.mkdir(parents=True, exist_ok=True)

    if not todo.exists():
        todo.write_text(
            f"# Tasks for {root.name}\n\n## ⏳ Backlog\n- [ ] Initial project setup\n",
            encoding="utf-8",
        )

    # Clean up obsolete bulletin.md if present
    bulletin = ai_dir / "bulletin.md"
    if bulletin.is_file():
        bulletin.unlink()

    cmd_sync_main_plan(root, silent=True)
    print(f"✅ Initialized portable Town tracking structure in {root}")
    print("   Created: ai/plan.md (Main Plan), ai/plans/ (Sub-plans), ai/ledger.md, ai/todo.md")


def cmd_clean(root: Path):
    """Clean temporary scratch files, __pycache__, and remove obsolete bulletin.md."""
    cleaned = []
    scratch_dir = root / "ai" / "scratch"
    if scratch_dir.is_dir():
        for f in scratch_dir.glob("*"):
            if f.is_file():
                f.unlink()
                cleaned.append(f"ai/scratch/{f.name}")

    for p in root.rglob("__pycache__"):
        if p.is_dir() and "syncthing" not in str(p):
            import shutil
            shutil.rmtree(p, ignore_errors=True)
            cleaned.append(str(p.relative_to(root)))

    for p in root.rglob(".pytest_cache"):
        if p.is_dir() and "syncthing" not in str(p):
            import shutil
            shutil.rmtree(p, ignore_errors=True)
            cleaned.append(str(p.relative_to(root)))

    bulletin = root / "ai" / "bulletin.md"
    if bulletin.is_file():
        bulletin.unlink()
        cleaned.append("ai/bulletin.md (purged obsolete bulletin)")

    cmd_sync_main_plan(root, silent=True)

    if cleaned:
        print(f"🧹 Cleaned {len(cleaned)} item(s) in {root.name}:")
        for item in cleaned:
            print(f"   • {item}")
    else:
        print(f"✨ Project {root.name} is already completely clean.")


def main():
    parser = argparse.ArgumentParser(
        prog="town",
        description="Portable task and multi-agent plan tracker across workspaces.",
    )
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("status", help="Show current project work status (default)")
    subparsers.add_parser("list", help="List all plans in the current project")

    show_parser = subparsers.add_parser("show", help="Show details of a plan or Main Plan")
    show_parser.add_argument("plan_id", nargs="?", help="Plan ID to show (or 'main' for Main Plan)")

    new_parser = subparsers.add_parser("new", help="Create a new sub-plan in ai/plans/ and reference in ai/plan.md")
    new_parser.add_argument("title", help="Title of the plan")
    new_parser.add_argument("--flow", default="Flow 1 (Full Council)", help="Assigned flow (default: Full Council)")

    subparsers.add_parser("init", help="Initialize town tracking structure in current directory")
    subparsers.add_parser("sync", help="Sync ai/plan.md (Main Plan) and ai/ledger.md from ai/plans/")
    subparsers.add_parser("clean", help="Clean temporary scratch files, caches, and obsolete bulletin")

    args = parser.parse_args()
    root = find_project_root()

    if args.command in [None, "status"]:
        cmd_status(root)
    elif args.command == "list":
        cmd_list(root)
    elif args.command == "show":
        cmd_show(root, args.plan_id)
    elif args.command == "new":
        cmd_new(root, args.title, args.flow)
    elif args.command == "init":
        cmd_init(Path.cwd())
    elif args.command == "sync":
        cmd_sync_main_plan(root, silent=False)
    elif args.command == "clean":
        cmd_clean(root)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
