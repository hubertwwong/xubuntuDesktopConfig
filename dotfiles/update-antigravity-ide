#!/usr/bin/env bash
#
# update-antigravity-ide: Dynamic Updater for Google Antigravity IDE on Linux
#

set -euo pipefail

INSTALL_DIR="/opt/antigravity-ide"
APP_DIR="$INSTALL_DIR/Antigravity-IDE"
VERSION_FILE="$INSTALL_DIR/.antigravity-linux-version"
SOURCE_URL_FILE="$INSTALL_DIR/.antigravity-linux-source-url"
DESKTOP_FILE="/usr/share/applications/antigravity-ide.desktop"
BIN_LINK="/usr/local/bin/antigravity-ide"

CURRENT_VERSION="unknown"
if [ -f "$VERSION_FILE" ]; then
    CURRENT_VERSION=$(cat "$VERSION_FILE" | tr -d '[:space:]')
fi

echo "Antigravity IDE - Current Installed Version: $CURRENT_VERSION"

# 1. Fetch Latest Download URL dynamically from official site
echo "Checking for latest release on antigravity.google..."
LATEST_URL=""
if command -v curl >/dev/null 2>&1; then
    LATEST_URL=$(curl -sL --compressed "https://antigravity.google/download" 2>/dev/null | grep -o 'https://edgedl.me.gvt1.com/edgedl/release2/[^"]*linux-x64/Antigravity%20IDE.tar.gz' | head -n 1 || true)
fi

# Fallback to stored URL or known latest release if scraping fails
if [ -z "$LATEST_URL" ]; then
    if [ -f "$SOURCE_URL_FILE" ]; then
        LATEST_URL=$(cat "$SOURCE_URL_FILE" | tr -d '[:space:]')
    else
        LATEST_URL="https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/2.5.5-4923483625488384/linux-x64/Antigravity%20IDE.tar.gz"
    fi
fi

# If a custom URL is explicitly passed as argument:
if [ "${1:-}" != "" ] && [ "${1:-}" != "-y" ]; then
    if [[ "$1" =~ ^https?:// ]]; then
        LATEST_URL="$1"
    fi
fi

# Extract version from URL if available
TARGET_VERSION=$(echo "$LATEST_URL" | grep -o 'stable/[^/]*' | cut -d'/' -f2 | cut -d'-' -f1 || echo "latest")
echo "Latest Available Version: $TARGET_VERSION"
echo "Download URL: $LATEST_URL"

# Check if already on target version (unless forced)
if [ "$CURRENT_VERSION" = "$TARGET_VERSION" ] && [ "${1:-}" != "--force" ]; then
    echo "✓ Antigravity IDE is already up-to-date ($CURRENT_VERSION)."
    exit 0
fi

# Create temporary staging directory
TMP_DIR=$(mktemp -d /tmp/antigravity-ide-update.XXXXXX)
cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

ARCHIVE="$TMP_DIR/Antigravity_IDE.tar.gz"

echo "Downloading Antigravity IDE ($TARGET_VERSION)..."
curl -fSL -o "$ARCHIVE" "$LATEST_URL"

echo "Extracting package..."
mkdir -p "$TMP_DIR/extracted"
tar -xzf "$ARCHIVE" -C "$TMP_DIR/extracted"

# Locate extracted app directory
EXTRACTED_APP=$(find "$TMP_DIR/extracted" -maxdepth 2 -type f -name "antigravity-ide" -exec dirname {} \;)

if [ -z "$EXTRACTED_APP" ] || [ ! -d "$EXTRACTED_APP" ]; then
    echo "Error: Could not locate extracted Antigravity IDE application directory" >&2
    exit 1
fi

# Ensure target directory exists
sudo mkdir -p "$INSTALL_DIR"

# Install to application directory
echo "Installing to $APP_DIR..."
sudo rm -rf "$APP_DIR.old"
if [ -d "$APP_DIR" ]; then
    sudo mv "$APP_DIR" "$APP_DIR.old"
fi

sudo mv "$EXTRACTED_APP" "$APP_DIR"
sudo rm -rf "$APP_DIR.old"

# Configure chrome-sandbox permissions for Electron SUID sandbox
if [ -f "$APP_DIR/chrome-sandbox" ]; then
    sudo chown root:root "$APP_DIR/chrome-sandbox"
    sudo chmod 4755 "$APP_DIR/chrome-sandbox"
fi

# Update symlink
sudo ln -sf "$APP_DIR/antigravity-ide" "$BIN_LINK"

# Save updated URL and Version
echo "$LATEST_URL" | sudo tee "$SOURCE_URL_FILE" > /dev/null

if [ -f "$APP_DIR/resources/app/product.json" ]; then
    NEW_VERSION=$(grep -o '"ideVersion"[[:space:]]*:[[:space:]]*"[^"]*"' "$APP_DIR/resources/app/product.json" | cut -d'"' -f4 || echo "$TARGET_VERSION")
    echo "$NEW_VERSION" | sudo tee "$VERSION_FILE" > /dev/null
    echo "✓ Successfully upgraded Antigravity IDE to version: $NEW_VERSION"
else
    echo "$TARGET_VERSION" | sudo tee "$VERSION_FILE" > /dev/null
    echo "✓ Antigravity IDE updated successfully to: $TARGET_VERSION"
fi

# Verify desktop shortcut exists
if [ ! -f "$DESKTOP_FILE" ]; then
    sudo tee "$DESKTOP_FILE" > /dev/null << 'DESKTOPEOF'
[Desktop Entry]
Name=Antigravity IDE
Comment=Google Antigravity IDE
Exec=/usr/local/bin/antigravity-ide %F
Icon=antigravity-ide
Terminal=false
Type=Application
Categories=Development;IDE;
MimeType=inode/directory;text/plain;application/x-code-workspace;application/x-antigravity-workspace;x-scheme-handler/antigravity-ide;
StartupNotify=true
StartupWMClass=antigravity-ide
DESKTOPEOF
fi

echo "✓ Upgrade complete."
